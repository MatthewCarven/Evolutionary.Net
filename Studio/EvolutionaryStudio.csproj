<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>EvolutionaryStudio</AssemblyName>
    <RootNamespace>EvolutionaryStudio</RootNamespace>
    <ApplicationManifest></ApplicationManifest>
  </PropertyGroup>

  <!-- Compile the engine sources directly; the legacy Engine/Evolutionary.csproj stays untouched for VS users -->
  <ItemGroup>
    <Compile Include="..\Engine\*.cs" LinkBase="Engine" />
  </ItemGroup>

  <!-- Bundle the sample dataset for the bike-sharing preset -->
  <ItemGroup>
    <Content Include="..\Examples\PredictionRegression\bike-sharing-by-day.csv" Link="Data\bike-sharing-by-day.csv" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
