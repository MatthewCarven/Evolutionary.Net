<Window x:Class="EvolutionaryStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:EvolutionaryStudio.Controls"
        Title="Evolutionary Studio — GP runner &amp; examiner for Evolutionary.Net"
        Width="1360" Height="860" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        Background="{StaticResource PanelBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- toolbar -->
        <Border Grid.Row="0" Background="White" Padding="12,9" BorderBrush="#DDE2EA" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button x:Name="btnRun" Style="{StaticResource RunButton}" Content="▶  Run" Click="BtnRun_Click"/>
                    <Button x:Name="btnStop" Style="{StaticResource StopButton}" Content="■  Stop" IsEnabled="False" Click="BtnStop_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button x:Name="btnSaveSetup" Content="Save setup…" Padding="10,4" Margin="0,0,8,0" Click="BtnSaveSetup_Click"
                            ToolTip="Save the whole configuration (mode, problem, primitives, engine parameters) as a JSON file"/>
                    <Button x:Name="btnLoadSetup" Content="Load setup…" Padding="10,4" Click="BtnLoadSetup_Click"
                            ToolTip="Restore a configuration saved with 'Save setup'"/>
                </StackPanel>
                <TextBlock x:Name="txtRunStatus" VerticalAlignment="Center" Margin="18,0,12,0" Text="Ready — pick a problem and press Run." FontSize="13"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- configuration panel -->
            <ScrollViewer x:Name="panelConfig" Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="10,10,4,10">
                <StackPanel>
                    <GroupBox>
                        <GroupBox.Header><TextBlock Text="Mode" Style="{StaticResource SectionHeader}"/></GroupBox.Header>
                        <ComboBox x:Name="cboMode" Margin="0,2" SelectionChanged="CboMode_SelectionChanged">
                            <ComboBoxItem Content="Symbolic regression — fit a formula to data" IsSelected="True"/>
                            <ComboBoxItem Content="Blackjack strategy — evolve how to play"/>
                            <ComboBoxItem Content="Snake — evolve a self-driving snake"/>
                        </ComboBox>
                    </GroupBox>

                    <GroupBox x:Name="grpBlackjack" Visibility="Collapsed">
                        <GroupBox.Header><TextBlock Text="Blackjack settings" Style="{StaticResource SectionHeader}"/></GroupBox.Header>
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/><RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Hands per fitness eval" Style="{StaticResource ParamLabel}"/>
                                <TextBox x:Name="txtBjHands" Grid.Row="0" Grid.Column="1" Style="{StaticResource ParamBox}" Text="25000"/>
                                <TextBlock Grid.Row="1" Text="Number of decks" Style="{StaticResource ParamLabel}"/>
                                <TextBox x:Name="txtBjDecks" Grid.Row="1" Grid.Column="1" Style="{StaticResource ParamBox}" Text="4"/>
                            </Grid>
                            <CheckBox x:Name="chkBjStack" Content="Stack the deck (more pairs/soft hands)" Margin="0,6,0,0"/>
                            <TextBlock Foreground="DimGray" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"
                                       Text="Each candidate's tree votes Hit / Stand / Double / Split for every situation; fitness is chips won playing that strategy (2-chip bets). Scores are negative — the house has an edge — so evolution climbs toward the least-losing strategy. More hands = steadier scores but slower generations."/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox x:Name="grpSnake" Visibility="Collapsed">
                        <GroupBox.Header><TextBlock Text="Snake settings" Style="{StaticResource SectionHeader}"/></GroupBox.Header>
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/><RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Board size (N×N)" Style="{StaticResource ParamLabel}"/>
                                <TextBox x:Name="txtSnakeBoard" Grid.Row="0" Grid.Column="1" Style="{StaticResource ParamBox}" Text="12"/>
                                <TextBlock Grid.Row="1" Text="Games per fitness eval" Style="{StaticResource ParamLabel}"/>
                                <TextBox x:Name="txtSnakeGames" Grid.Row="1" Grid.Column="1" Style="{StaticResource ParamBox}" Text="4"/>
                            </Grid>
                            <TextBlock Foreground="DimGray" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"
                                       Text="Each candidate is a decision tree steering in the snake's own frame: senses like DangerAhead() and FoodLeft() feed votes for straight / turn left / turn right. Fitness = apples ×1000 + steps, with a hunger rule so circling forever scores nothing. Watch the champion play in the Examiner."/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox x:Name="grpProblem">
                        <GroupBox.Header><TextBlock Text="Problem" Style="{StaticResource SectionHeader}"/></GroupBox.Header>
                        <StackPanel>
                            <ComboBox x:Name="cboPreset" Margin="0,2" SelectionChanged="CboPreset_SelectionChanged"/>
                            <Button x:Name="btnLoadCsv" Content="Load CSV…" Click="BtnLoadCsv_Click" Margin="0,6,0,2" HorizontalAlignment="Left" Padding="10,3"/>
                            <TextBlock x:Name="txtDatasetInfo" TextWrapping="Wrap" Foreground="DimGray" Margin="0,4,0,0"/>
                            <TextBlock Text="Target column (what to predict):" Margin="0,8,0,2"/>
                            <ComboBox x:Name="cboTarget" SelectionChanged="CboTarget_SelectionChanged"/>
                            <TextBlock Text="Input columns (variables):" Margin="0,8,0,2"/>
                            <ItemsControl x:Name="icColumns">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Name}" Margin="0,1"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <DockPanel Margin="0,10,0,0">
                                <TextBlock Text="Train / test split:" Style="{StaticResource ParamLabel}"/>
                                <TextBlock x:Name="lblTrain" DockPanel.Dock="Right" Foreground="DimGray"/>
                            </DockPanel>
                            <Slider x:Name="sliderTrain" Minimum="50" Maximum="95" Value="75" TickFrequency="5"
                                    IsSnapToTickEnabled="True" ValueChanged="SliderTrain_ValueChanged"/>
                            <TextBlock Text="Fitness metric:" Margin="0,6,0,2"/>
                            <ComboBox x:Name="cboMetric">
                                <ComboBoxItem Content="MAE — mean absolute error" IsSelected="True"/>
                                <ComboBoxItem Content="RMSE — root mean squared error"/>
                            </ComboBox>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox x:Name="grpFunctions">
                        <GroupBox.Header><TextBlock Text="Functions (primitive set)" Style="{StaticResource SectionHeader}"/></GroupBox.Header>
                        <ItemsControl x:Name="icFunctions">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding CheckboxLabel}"
                                              ToolTip="{Binding Description}" Margin="0,1"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </GroupBox>

                    <GroupBox x:Name="grpConstants">
                        <GroupBox.Header><TextBlock Text="Constants" Style="{StaticResource SectionHeader}"/></GroupBox.Header>
                        <StackPanel>
                            <TextBox x:Name="txtConstants" Style="{StaticResource ParamBox}" Text="0, 1, 2, 3, 5, 10, -1, 0.5"/>
                            <TextBlock Text="Comma-separated numeric constants available to the trees."
                                       Foreground="DimGray" TextWrapping="Wrap" FontSize="11" Margin="0,3,0,0"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox>
                        <GroupBox.Header><TextBlock Text="Engine parameters" Style="{StaticResource SectionHeader}"/></GroupBox.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                <RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Population size" Style="{StaticResource ParamLabel}"/>
                            <TextBox x:Name="txtPopulation" Grid.Row="0" Grid.Column="1" Style="{StaticResource ParamBox}" Text="500"/>

                            <TextBlock Grid.Row="1" Text="Min generations" Style="{StaticResource ParamLabel}"/>
                            <TextBox x:Name="txtMinGen" Grid.Row="1" Grid.Column="1" Style="{StaticResource ParamBox}" Text="20"/>

                            <TextBlock Grid.Row="2" Text="Max generations" Style="{StaticResource ParamLabel}"/>
                            <TextBox x:Name="txtMaxGen" Grid.Row="2" Grid.Column="1" Style="{StaticResource ParamBox}" Text="100"/>

                            <TextBlock Grid.Row="3" Text="Stagnant gens before stop" Style="{StaticResource ParamLabel}"/>
                            <TextBox x:Name="txtStagnant" Grid.Row="3" Grid.Column="1" Style="{StaticResource ParamBox}" Text="15"/>

                            <TextBlock Grid.Row="4" Text="Elitism rate (0–0.9)" Style="{StaticResource ParamLabel}"/>
                            <TextBox x:Name="txtElitism" Grid.Row="4" Grid.Column="1" Style="{StaticResource ParamBox}" Text="0.10"/>

                            <TextBlock Grid.Row="5" Text="Crossover rate (0–1)" Style="{StaticResource ParamLabel}"/>
                            <TextBox x:Name="txtCrossover" Grid.Row="5" Grid.Column="1" Style="{StaticResource ParamBox}" Text="0.95"/>

                            <TextBlock Grid.Row="6" Text="Mutation rate (0–1)" Style="{StaticResource ParamLabel}"/>
                            <TextBox x:Name="txtMutation" Grid.Row="6" Grid.Column="1" Style="{StaticResource ParamBox}" Text="0.05"/>

                            <TextBlock Grid.Row="7" Text="Random tree min depth" Style="{StaticResource ParamLabel}"/>
                            <TextBox x:Name="txtMinDepth" Grid.Row="7" Grid.Column="1" Style="{StaticResource ParamBox}" Text="3"/>

                            <TextBlock Grid.Row="8" Text="Random tree max depth" Style="{StaticResource ParamLabel}"/>
                            <TextBox x:Name="txtMaxDepth" Grid.Row="8" Grid.Column="1" Style="{StaticResource ParamBox}" Text="6"/>

                            <TextBlock Grid.Row="9" Text="Selection style" Style="{StaticResource ParamLabel}"/>
                            <ComboBox x:Name="cboSelection" Grid.Row="9" Grid.Column="1" Margin="0,2">
                                <ComboBoxItem Content="Tourney" IsSelected="True"/>
                                <ComboBoxItem Content="Roulette"/>
                                <ComboBoxItem Content="Ranked"/>
                            </ComboBox>

                            <TextBlock Grid.Row="10" Text="Tourney size" Style="{StaticResource ParamLabel}"/>
                            <TextBox x:Name="txtTourney" Grid.Row="10" Grid.Column="1" Style="{StaticResource ParamBox}" Text="4"/>
                        </Grid>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <!-- main tabs -->
            <TabControl x:Name="tabsMain" Grid.Column="1" Margin="4,10,10,10">
                <TabItem Header="Evolution">
                    <Grid Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3*"/>
                            <RowDefinition Height="2*"/>
                        </Grid.RowDefinitions>
                        <Border Background="White" BorderBrush="#DDE2EA" BorderThickness="1" CornerRadius="4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <DockPanel Margin="10,8,10,0">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                        <Button x:Name="btnExportCsv" Content="Export history CSV…" Padding="8,2" Margin="0,0,8,0" Click="BtnExportCsv_Click"/>
                                        <Button x:Name="btnSaveChart" Content="Save chart PNG…" Padding="8,2" Click="BtnSaveChart_Click"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox x:Name="chkShowAvg" Content="Show average fitness (clipped to chart range)"
                                                  IsChecked="True" Checked="ChkShowAvg_Changed" Unchecked="ChkShowAvg_Changed"/>
                                        <CheckBox x:Name="chkLogScale" Content="Log scale" Margin="18,0,0,0"
                                                  ToolTip="Log₁₀ fitness axis — shows late-run progress that looks flat on a linear axis"
                                                  Checked="ChkLogScale_Changed" Unchecked="ChkLogScale_Changed"/>
                                    </StackPanel>
                                </DockPanel>
                                <controls:PlotCanvas x:Name="plotFitness" Grid.Row="1" Margin="4"/>
                            </Grid>
                        </Border>
                        <DataGrid x:Name="gridHistory" Grid.Row="1" Margin="0,8,0,0" IsReadOnly="True"
                                  AutoGenerateColumns="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  CanUserAddRows="False" Background="White" RowBackground="White" AlternatingRowBackground="#F7F9FC">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Gen" Binding="{Binding Generation}" Width="70"/>
                                <DataGridTextColumn Header="Best (this gen)" Binding="{Binding BestThisGen, StringFormat=G6}" Width="130"/>
                                <DataGridTextColumn Header="Average (this gen)" Binding="{Binding AvgThisGen, StringFormat=G6}" Width="150"/>
                                <DataGridTextColumn Header="Best so far" Binding="{Binding BestSoFar, StringFormat=G6}" Width="130"/>
                                <DataGridTextColumn Header="ms / gen" Binding="{Binding Milliseconds, StringFormat=F0}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="Examiner">
                    <Grid Margin="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="215"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock DockPanel.Dock="Top" Text="Best-so-far snapshots" Style="{StaticResource SectionHeader}" Margin="2,0,0,4"/>
                            <CheckBox DockPanel.Dock="Top" x:Name="chkFollow" Content="Follow new bests" IsChecked="True" Margin="2,0,0,6"/>
                            <ListBox x:Name="lstSnapshots" DisplayMemberPath="Label" SelectionChanged="LstSnapshots_SelectionChanged"
                                     FontFamily="Consolas" FontSize="12"/>
                        </DockPanel>

                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <GroupBox Grid.Row="0">
                                <GroupBox.Header><TextBlock Text="Selected solution" Style="{StaticResource SectionHeader}"/></GroupBox.Header>
                                <StackPanel>
                                    <TextBox x:Name="txtInfix" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="72"
                                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13"
                                             BorderThickness="0" Background="Transparent" Text="Run the engine to produce solutions."/>
                                    <TextBlock x:Name="txtSnapshotStats" Foreground="DimGray" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button x:Name="btnCopyInfix" Content="Copy infix" Padding="10,3" Click="BtnCopyInfix_Click"/>
                                        <Button x:Name="btnCopyRaw" Content="Copy raw (engine form)" Padding="10,3" Margin="8,0,0,0" Click="BtnCopyRaw_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>

                            <TabControl x:Name="tabsExaminer" Grid.Row="1" Margin="0,4,0,0">
                                <TabItem x:Name="tabStrategy" Header="Strategy" Visibility="Collapsed">
                                    <Grid Background="White">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                            <controls:StrategyGrid x:Name="strategyGrid" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6"/>
                                        </ScrollViewer>
                                        <DockPanel Grid.Row="1" Margin="12,4,12,10">
                                            <Button x:Name="btnSaveStrategy" Content="Save PNG…" Padding="8,2" DockPanel.Dock="Right"
                                                    VerticalAlignment="Bottom" Click="BtnSaveStrategy_Click"/>
                                            <TextBlock x:Name="txtStrategyInfo" Margin="0,0,12,0"
                                                       FontFamily="Consolas" FontSize="13" TextWrapping="Wrap"/>
                                        </DockPanel>
                                    </Grid>
                                </TabItem>
                                <TabItem x:Name="tabWatch" Header="Watch" Visibility="Collapsed">
                                    <Grid Background="White">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal" Margin="8,8,8,4">
                                            <Button x:Name="btnReplayPause" Content="Pause" Padding="10,2" Click="BtnReplayPause_Click"/>
                                            <Button x:Name="btnReplayNew" Content="New game" Padding="10,2" Margin="8,0,0,0" Click="BtnReplayNew_Click"/>
                                            <TextBlock Text="Speed:" VerticalAlignment="Center" Margin="16,0,6,0"/>
                                            <Slider x:Name="sliderReplaySpeed" Minimum="4" Maximum="30" Value="12" Width="120"
                                                    VerticalAlignment="Center" ValueChanged="SliderReplaySpeed_ValueChanged"/>
                                            <TextBlock x:Name="txtReplayInfo" VerticalAlignment="Center" Margin="16,0,0,0"
                                                       FontFamily="Consolas"/>
                                        </StackPanel>
                                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                            <controls:SnakeBoard x:Name="snakeBoard" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8"/>
                                        </ScrollViewer>
                                    </Grid>
                                </TabItem>
                                <TabItem x:Name="tabTree" Header="Tree">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal" Margin="6,6,6,4">
                                            <TextBlock Text="Zoom:" VerticalAlignment="Center"/>
                                            <Slider x:Name="sliderZoom" Minimum="0.3" Maximum="2.0" Value="1.0" Width="150"
                                                    Margin="8,0,20,0" VerticalAlignment="Center" ValueChanged="SliderZoom_ValueChanged"/>
                                            <Border Background="#3A6EB5" CornerRadius="3" Padding="6,1" Margin="0,0,6,0"><TextBlock Text="function" Foreground="White" FontSize="11"/></Border>
                                            <Border Background="#3E9B4F" CornerRadius="3" Padding="6,1" Margin="0,0,6,0"><TextBlock Text="variable" Foreground="White" FontSize="11"/></Border>
                                            <Border Background="#D88A2A" CornerRadius="3" Padding="6,1" Margin="0,0,6,0"><TextBlock Text="constant" Foreground="White" FontSize="11"/></Border>
                                            <Border Background="#8E5BC0" CornerRadius="3" Padding="6,1"><TextBlock Text="terminal fn" Foreground="White" FontSize="11"/></Border>
                                            <Button x:Name="btnSaveTree" Content="Save PNG…" Padding="8,2" Margin="18,0,0,0" Click="BtnSaveTree_Click"/>
                                        </StackPanel>
                                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="White">
                                            <controls:TreeDiagram x:Name="treeDiagram"/>
                                        </ScrollViewer>
                                    </Grid>
                                </TabItem>
                                <TabItem x:Name="tabFit" Header="Fit quality">
                                    <Grid Background="White">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <controls:PlotCanvas x:Name="plotFit" Margin="4"/>
                                        <TextBlock x:Name="txtFitMetrics" Grid.Row="1" Margin="12,4,12,10" FontFamily="Consolas" FontSize="13"/>
                                    </Grid>
                                </TabItem>
                                <TabItem x:Name="tabPlayground" Header="Playground">
                                    <StackPanel Margin="12" Background="White">
                                        <TextBlock Text="Set variable values, then evaluate the selected solution:" Margin="0,4,0,8"/>
                                        <DataGrid x:Name="gridPlayground" AutoGenerateColumns="False" CanUserAddRows="False"
                                                  Width="300" HorizontalAlignment="Left" HeadersVisibility="Column">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Variable" Binding="{Binding Variable}" IsReadOnly="True" Width="140"/>
                                                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="140"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button x:Name="btnEvaluate" Content="Evaluate" Padding="14,4" Click="BtnEvaluate_Click"/>
                                            <TextBlock x:Name="txtEvalResult" VerticalAlignment="Center" Margin="14,0,0,0"
                                                       FontFamily="Consolas" FontSize="14"/>
                                        </StackPanel>
                                    </StackPanel>
                                </TabItem>
                            </TabControl>
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <StatusBar Grid.Row="2">
            <TextBlock x:Name="txtStatusBar" Text="Evolutionary Studio — GUI for the Evolutionary.Net genetic programming engine"/>
        </StatusBar>
    </Grid>
</Window>
